{
  "name": "maintenance-records",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"pnpm --filter @mr/server dev\" \"pnpm --filter @mr/web dev\"",
    "build": "pnpm --filter @mr/server build && pnpm --filter @mr/web build",
    "start": "pnpm --filter @mr/server start",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "export": "pnpm --filter @mr/server export",
    "import": "pnpm --filter @mr/server import",
    "seed": "pnpm --filter @mr/server seed"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}